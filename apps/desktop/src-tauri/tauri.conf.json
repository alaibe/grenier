{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grenier",
  "version": "0.1.9",
  "identifier": "cc.laibe.grenier",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. build && pnpm sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grenier",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "externalBin": ["binaries/grenier-node"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "linux": {
      "deb": { "files": { "/usr/bin/grenier": "../bin/grenier-linux" } },
      "rpm": { "files": { "/usr/bin/grenier": "../bin/grenier-linux" } }
    },
    "resources": { "../resources/grenier/": "grenier/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGNjg1QTI4QUMyRkU0RUUKUldUdTVDK3NLRnBvSHh1a3paNm5XMkZPYlBPYWVrSitqVWdoN3RnQ0dCTnpab3lueFNHR1BtdzcK",
      "endpoints": ["https://github.com/alaibe/grenier/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
