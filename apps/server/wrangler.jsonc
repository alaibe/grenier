// Local development only: a real deployment goes through Cloudflare's API from the app (apps/cli/src/deploy.ts).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grenier-team",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": { "bindings": [{ "name": "TEAM", "class_name": "TeamStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TeamStore"] }]
}
