{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/*.md", "!packages/store/migrations/meta"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        },
        "useExportType": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useForOf": "error"
      },
      "suspicious": {
        "noEvolvingTypes": "error",
        "noVar": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/**", "apps/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "better-sqlite3": "Only packages/store talks to SQLite. Go through the store interface."
                },
                "patterns": [
                  {
                    "group": ["@grenier/cli", "@grenier/server", "@grenier/desktop", "**/apps/**"],
                    "message": "packages/* never import from apps/*."
                  },
                  {
                    "group": ["drizzle-orm", "drizzle-orm/**"],
                    "message": "Only packages/store uses Drizzle. Go through the store interface."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/store/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "better-sqlite3": "Only packages/store talks to SQLite. Go through the store interface."
                },
                "patterns": [
                  {
                    "group": ["@grenier/cli", "@grenier/server", "@grenier/desktop", "**/apps/**"],
                    "message": "packages/* never import from apps/*."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/store/src/sqlite.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@grenier/cli", "@grenier/server", "@grenier/desktop", "**/apps/**"],
                    "message": "packages/* never import from apps/*."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/core/src/**",
        "packages/store/src/**",
        "!packages/core/src/node.ts",
        "!packages/store/src/sqlite.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.config.ts", "types/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
