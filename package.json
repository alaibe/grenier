{
  "name": "grenier-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Sits between AI tools and everything they read: caches what coding agents learn and controls their spend.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter @grenier/server build && pnpm --filter @grenier/cli build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc && tsc -p apps/server && tsc -p apps/desktop",
    "test": "vitest run",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "db:generate": "pnpm --filter @grenier/store exec drizzle-kit generate",
    "test:agents": "pnpm build && vitest run --config vitest.agents.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@grenier/connectors": "workspace:*",
    "@grenier/core": "workspace:*",
    "@grenier/gateway": "workspace:*",
    "@grenier/index": "workspace:*",
    "@grenier/log": "workspace:*",
    "@grenier/store": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "miniflare": "5.20261109.0-beta",
    "smol-toml": "1.9.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
