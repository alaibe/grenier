{
  "name": "grenier-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Sits between AI tools and everything they read: caches what coding agents learn and controls their spend.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter @grenier/cli build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@grenier/core": "workspace:*",
    "@grenier/store": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "better-sqlite3": "13.0.3",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
